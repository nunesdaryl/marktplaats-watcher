# Python API (main.py / agent.py). Copy to .env for local runs; set the same names in Vercel.
# Never commit real values.

# OpenAI: platform.openai.com -> API keys. Set a monthly budget limit there first.
OPENAI_API_KEY=<your key>
OPENAI_MODEL=<a small chat model with tool calling, e.g. the current "mini" model>

# Clerk: dashboard -> Configure -> API keys -> "Frontend API URL" (the issuer of session tokens)
CLERK_ISSUER=https://<your-app>.clerk.accounts.dev

# Shared secret between Convex's scheduled checks and /api/internal/check.
# Make one with:  openssl rand -hex 32   and set the SAME value in Convex (npx convex env set CRON_SECRET ...)
CRON_SECRET=<random string>

# Leave unset until the 24-hour seller-website signal review confirms precision.
BUSINESS_SELLER_FILTER_ENABLED=0

# Optional limits
RATE_PER_MINUTE=10
MAX_FETCHES_PER_HOUR=30

# The aud claim on Clerk session tokens (Clerk's Convex integration sets "convex")
CLERK_AUDIENCE=convex
