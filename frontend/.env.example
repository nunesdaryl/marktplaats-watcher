# Browser build settings (public values, but keep real ones in .env.local, which is not committed).
# NEXT_PUBLIC_CONVEX_URL: printed by `npx convex dev` (dev) or `npx convex deploy` (production).
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# Clerk dashboard -> API keys -> Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<...>
